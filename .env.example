# Copy to .env and fill in real values. Never commit .env.

# Database (docker-compose postgres)
DB_NAME=wallet
DB_USER=wallet
DB_PASSWORD=wallet
DB_URL=jdbc:postgresql://db:5432/wallet

# JWT: at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_ME-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# Wallet
WALLET_CURRENCY=EGP
SERVER_PORT=8081

# Paymob (dashboard -> Settings -> API Keys / Integrations)
PAYMOB_ENABLED=false
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=0
PAYMOB_IFRAME_ID=0
PAYMOB_HMAC_SECRET=

# Email (docker-compose runs Mailhog on 1025; web UI on http://localhost:8025)
MAIL_ENABLED=true
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=wallet-service@localhost
